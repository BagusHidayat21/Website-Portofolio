generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id              Int      @id @default(1)
  name            String
  tagline         String
  bio             String   @db.Text
  avatarUrl       String?
  resumeUrl       String?
  email           String
  location        String
  yearsCoding     Int      @default(0)
  projectsCount   Int      @default(0)
  
  // Social Links
  githubUrl       String?
  linkedinUrl     String?
  twitterUrl      String?
  instagramUrl    String?
  
  isAvailableForWork Boolean @default(true)
  
  updatedAt       DateTime @updatedAt
}

model Project {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // For URL friendly routing
  title       String
  description String   @db.Text
  content     String?  @db.Text // Markdown content for case study
  
  // Links
  githubUrl   String?
  liveUrl     String?
  
  // Media
  thumbnail   String?
  images      String[]
  
  // Metadata
  techStack   String[] // Array of strings for tech used
  tags        String[]
  
  isFeatured  Boolean  @default(false)
  isVisible   Boolean  @default(true)
  order       Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TechStack {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  category    String   // e.g. "Frontend", "Backend", "Language", "Tool"
  icon        String?  // Could be an SVG string or URL
  
  isVisible   Boolean  @default(true)
  inMarquee   Boolean  @default(false) // For the infinite horizontal scroll
  
  order       Int      @default(0)
}

model Experience {
  id          Int      @id @default(autoincrement())
  company     String
  position    String
  startDate   DateTime
  endDate     DateTime? // Null means "Present"
  description String   @db.Text
  location    String?
  
  isVisible   Boolean  @default(true)
  order       Int      @default(0)
}
